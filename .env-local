# ============================================================================
# BooksKDP - MODO LOCAL (sem custos de API)
# ============================================================================
# Usa Ollama para LLM, ComfyUI para imagens, LanguageTool local
#
# REQUISITOS:
#   1. Ollama: https://ollama.ai + ollama pull qwen2.5:14b
#   2. LanguageTool: docker run -d -p 8010:8010 erikvl87/languagetool
#   3. ComfyUI: https://github.com/comfyanonymous/ComfyUI + modelo SDXL
#
# ATIVAR: copy .env-local .env
# ============================================================================

# ----------------------------------------------------------------------------
# MODO DE EXECUCAO
# ----------------------------------------------------------------------------
EXECUTION_MODE=local

# ----------------------------------------------------------------------------
# LLM - OLLAMA LOCAL
# ----------------------------------------------------------------------------
MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Alternativas de modelo (descomente uma):
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MODEL=mistral:7b
# OLLAMA_MODEL=gemma2:9b

# APIs cloud desabilitadas
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_REGION=
VERTEX_ACCESS_TOKEN=
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# TRADUCAO - LOCAL (via Ollama)
# ----------------------------------------------------------------------------
TRANSLATION_BACKEND=local

# Sem Google Cloud Translation
PROJECT_ID=

# ----------------------------------------------------------------------------
# GERACAO DE IMAGENS - COMFYUI + SDXL
# ----------------------------------------------------------------------------
IMAGE_BACKEND=comfyui
COMFYUI_URL=http://localhost:8188
COMFYUI_WORKFLOW=book_cover_sdxl

# Modelo SDXL (colocar em ComfyUI/models/checkpoints/)
# Recomendados:
#   - juggernautXL_v9.safetensors (realista)
#   - dreamshaperXL_v21.safetensors (artistico)
#   - sdxl_base_1.0.safetensors (base oficial)
SDXL_MODEL=sdxl_base_1.0.safetensors

# Configuracoes de geracao
SDXL_WIDTH=832
SDXL_HEIGHT=1216
SDXL_STEPS=25
SDXL_CFG=7.0

XAI_API_KEY=

# ----------------------------------------------------------------------------
# CLOUD STORAGE - DESABILITADO
# ----------------------------------------------------------------------------
GCS_ENABLED=false
BUCKET_NAME=

# ----------------------------------------------------------------------------
# CORRECAO ORTOGRAFICA - LANGUAGETOOL LOCAL
# ----------------------------------------------------------------------------
# Docker: docker run -d -p 8010:8010 erikvl87/languagetool
GRAMMAR_BACKEND=languagetool
LANGUAGETOOL_URL=http://localhost:8010/v2/check

# Fallback para API publica (com limites):
# LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
