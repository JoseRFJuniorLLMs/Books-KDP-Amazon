# ============================================================================
# BooksKDP - Configuracao de Ambiente
# ============================================================================
# Copie este arquivo para .env-local ou .env-gcp
#
# USO:
#   Local:  copy .env-local .env
#   GCP:    copy .env-gcp .env
# ============================================================================

# ----------------------------------------------------------------------------
# MODO DE EXECUCAO
# ----------------------------------------------------------------------------
# Opcoes: local | gcp
EXECUTION_MODE=local

# ----------------------------------------------------------------------------
# LLM - MODELO DE LINGUAGEM
# ----------------------------------------------------------------------------
# Backend: ollama | gemini | vertex | openai
MODEL_BACKEND=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Gemini API (cloud)
GEMINI_API_KEY=

# Vertex AI (GCP)
VERTEX_PROJECT=
VERTEX_REGION=us-central1
VERTEX_ACCESS_TOKEN=

# OpenAI (alternativa)
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# TRADUCAO
# ----------------------------------------------------------------------------
# Backend: local | google_cloud
TRANSLATION_BACKEND=local

# Google Cloud Translation (requer PROJECT_ID)
PROJECT_ID=

# ----------------------------------------------------------------------------
# GERACAO DE IMAGENS (CAPAS)
# ----------------------------------------------------------------------------
# Backend: none | comfyui | gemini | dalle | xai
IMAGE_BACKEND=none

# ComfyUI + SDXL (local)
COMFYUI_URL=http://localhost:8188
COMFYUI_WORKFLOW=book_cover_sdxl
SDXL_MODEL=sdxl_base_1.0.safetensors
SDXL_WIDTH=832
SDXL_HEIGHT=1216
SDXL_STEPS=25
SDXL_CFG=7.0

# xAI Grok (cloud)
XAI_API_KEY=

# ----------------------------------------------------------------------------
# CLOUD STORAGE (GCP)
# ----------------------------------------------------------------------------
BUCKET_NAME=
GCS_ENABLED=false

# ----------------------------------------------------------------------------
# CORRECAO ORTOGRAFICA
# ----------------------------------------------------------------------------
# Backend: none | languagetool
GRAMMAR_BACKEND=languagetool

# LanguageTool
# Local (Docker): http://localhost:8010/v2/check
# Publico (limites): https://api.languagetool.org/v2/check
LANGUAGETOOL_URL=http://localhost:8010/v2/check
